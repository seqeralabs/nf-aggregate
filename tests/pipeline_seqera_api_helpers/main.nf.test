nextflow_pipeline {
    name "SeqeraApi helper smoke"
    script "run.nf"
    tag "pipeline"
    tag "nf-aggregate"
    tag "seqera-api"

    test("SeqeraApi pagination and workspace resolution") {
        tag("test")

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.succeeded().size() == 0
        }
    }
}
